@* ============================================================ *@
@* INSTRUCCIONES DE LIMPIEZA EN VISTAS                         *@
@* ============================================================ *@
@*
   EN CADA VISTA LISTADA ABAJO, eliminá el bloque duplicado de
   alertas HTML. El _Layout ya se ocupa de mostrarlo vía toast.

   PATRÓN A ELIMINAR (existe en Create, Edit, Delete de Catálogo):
   ───────────────────────────────────────────────────────────────
   @if (TempData["Success"] != null)
   {
       <div class="alert alert-success alert-dismissible fade show" role="alert">
           @TempData["Success"]
           <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
       </div>
   }
   @if (TempData["Error"] != null)
   {
       <div class="alert alert-danger alert-dismissible fade show" role="alert">
           @TempData["Error"]
           <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
       </div>
   }

   Aplicar en: Create.cshtml, Edit.cshtml, Delete.cshtml, Index.cshtml
   (Areas/Admin/Views/Catalogo/)
*@


@* ============================================================ *@
@* ARCHIVO COMPLETO: Areas/Admin/Views/Catalogo/Index.cshtml   *@
@* CAMBIOS: eliminados bloques alert duplicados + limpieza Swal *@
@* ============================================================ *@
@model List<AppWeb1.Models.Producto>
@{
    ViewData["Title"] = "Gestión de Catálogo";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Catálogo de Productos</h2>
        <a asp-area="Admin" asp-controller="Catalogo" asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Nuevo Producto
        </a>
    </div>

    @* ── Alertas HTML eliminadas: el Layout las muestra como toast ── *@

    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" id="buscadorProductos" class="form-control"
                   placeholder="Buscar productos por nombre o descripción...">
        </div>
        <div class="col-md-6">
            <div class="text-end">
                <span class="text-muted">
                    Total de productos: <strong id="totalProductos">@(Model?.Count ?? 0)</strong>
                </span>
            </div>
        </div>
    </div>

    <div class="row" id="contenedorProductos">
        @if (Model != null && Model.Any())
        {
            @foreach (var producto in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4 producto-card"
                     data-nombre="@producto.NombreProducto?.ToLower()"
                     data-descripcion="@producto.Descripcion?.ToLower()">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(producto.Imagen))
                        {
                            <img src="~/imagenes/@producto.Imagen"
                                 class="card-img-top producto-img"
                                 alt="@producto.NombreProducto"
                                 style="height:200px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center bg-light"
                                 style="height:200px;">
                                <i class="fas fa-image fa-3x text-muted"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@producto.NombreProducto</h5>
                            <p class="card-text flex-grow-1">@producto.Descripcion</p>
                            <p class="card-text">
                                <strong class="text-success fs-5">@producto.Precio?.ToString("C")</strong>
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="btn-group w-100" role="group">
                                <a asp-area="Admin" asp-controller="Catalogo" asp-action="Edit"
                                   asp-route-id="@producto.IdProducto"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                <a asp-area="Admin" asp-controller="Catalogo" asp-action="Delete"
                                   asp-route-id="@producto.IdProducto"
                                   class="btn btn-outline-danger btn-sm">
                                    <i class="fas fa-trash"></i> Eliminar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No hay productos en el catálogo</h4>
                    <p class="text-muted">Comenzá agregando tu primer producto</p>
                    <a asp-area="Admin" asp-controller="Catalogo" asp-action="Create" class="btn btn-success">
                        <i class="fas fa-plus"></i> Crear Primer Producto
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="mt-4">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver al Panel
        </a>
    </div>
</div>

@section Scripts {
    <script>
        // Buscador de productos
        document.getElementById('buscadorProductos').addEventListener('input', function () {
            const filtro = this.value.toLowerCase();
            let visibles = 0;
            document.querySelectorAll('.producto-card').forEach(function (card) {
                const nombre = card.getAttribute('data-nombre') || '';
                const desc   = card.getAttribute('data-descripcion') || '';
                const match  = nombre.includes(filtro) || desc.includes(filtro);
                card.style.display = match ? '' : 'none';
                if (match) visibles++;
            });
            document.getElementById('totalProductos').textContent = visibles;
        });
    </script>
}


@* ============================================================ *@
@* ARCHIVO COMPLETO: Areas/Admin/Views/Catalogo/Create.cshtml  *@
@* CAMBIOS: eliminados bloques alert duplicados                 *@
@* ============================================================ *@
@* (pega SOLO el contenido entre las marcas de archivo) *@
@*
@model AppWeb1.Models.Producto
@{
    ViewData["Title"] = "Crear Producto";
}

<h2>Crear Producto</h2>

@* ── Alertas eliminadas: el Layout las muestra como toast ── *@

<form asp-area="Admin" asp-controller="Catalogo" asp-action="Create"
      method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="form-group mb-3">
        <label asp-for="NombreProducto" class="form-label"></label>
        <input asp-for="NombreProducto" class="form-control" />
        <span asp-validation-for="NombreProducto" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="form-group mb-4">
        <label asp-for="ImagenArchivo" class="form-label">Seleccionar imagen</label>
        <input asp-for="ImagenArchivo" type="file" class="form-control"
               accept=".jpg,.jpeg,.png,.gif,.webp" />
        <span asp-validation-for="ImagenArchivo" class="text-danger"></span>
        <img id="previewImagen" class="img-thumbnail mt-3 d-none" style="max-height:150px;" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-area="Admin" asp-controller="Catalogo" asp-action="Index"
       class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('input[type="file"]').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e2 => {
                const img = document.getElementById('previewImagen');
                img.src = e2.target.result;
                img.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        });
    </script>
}
*@


