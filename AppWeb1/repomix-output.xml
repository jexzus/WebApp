<file path="Views/Usuario/ConfirmarPreRegistro.cshtml">
@{
    ViewData["Title"] = "Confirmar Pre-Registro";
    var email = (ViewBag.Email as string) ?? "";
    var readonlyAttr = string.IsNullOrWhiteSpace(email) ? "" : "readonly";
}

<div class="auth-page">
    <div class="auth-card shadow">
        <div class="auth-card__header">
            <h1 class="auth-title">Confirmar Pre-Registro</h1>
            <p class="auth-subtitle">Ingresá el código que te enviamos y definí tu contraseña.</p>
        </div>

        <form asp-controller="Usuario" asp-action="ConfirmarPreRegistro" method="post" novalidate class="auth-form">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="Email" class="form-label fw-semibold">Email</label>
                <input type="email" id="Email" name="Email"
                       value="@email"
                       class="form-control form-control-lg"
                       placeholder="tucorreo@ejemplo.com" @readonlyAttr />
            </div>

            <div class="mb-3">
                <label for="Codigo" class="form-label fw-semibold">Código de verificación</label>
                <input type="text" id="Codigo" name="Codigo" class="form-control form-control-lg" placeholder="Ej: 834921" required />
            </div>

            <div class="mb-3 position-relative">
                <label for="Password" class="form-label fw-semibold">Contraseña</label>
                <div class="input-group input-group-lg">
                    <input type="password" id="Password" name="Contraseña" class="form-control" minlength="6" required />
                    <button type="button" class="btn btn-outline-secondary" data-toggle-pass="#Password" aria-label="Mostrar/ocultar contraseña">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
                <div class="form-text">Mínimo 6 caracteres.</div>
            </div>

            <div class="mb-4 position-relative">
                <label for="ConfirmPassword" class="form-label fw-semibold">Confirmar contraseña</label>
                <div class="input-group input-group-lg">
                    <input type="password" id="ConfirmPassword" name="ConfirmarContraseña" class="form-control" minlength="6" required />
                    <button type="button" class="btn btn-outline-secondary" data-toggle-pass="#ConfirmPassword" aria-label="Mostrar/ocultar confirmación">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100 btn-auth">Validar y continuar</button>

            <div class="auth-footer mt-3 d-flex justify-content-between">
                <form asp-controller="Usuario" asp-action="ReenviarCodigo" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-link p-0">Reenviar código</button>
                </form>
                <a asp-controller="Usuario" asp-action="Login" class="link-secondary">Volver al login</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('form.auth-form')?.addEventListener('submit', e => {
            const btn = e.target.querySelector('button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Validando...';
            }
        });
        document.querySelectorAll('[data-toggle-pass]').forEach(btn => {
            btn.addEventListener('click', () => {
                const sel = btn.getAttribute('data-toggle-pass');
                const input = document.querySelector(sel);
                if (!input) return;
                input.type = input.type === 'password' ? 'text' : 'password';
                const icon = btn.querySelector('i');
                if (icon) icon.classList.toggle('fa-eye-slash');
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
</file>

<file path="Views/Usuario/CrearUsuario.cshtml">
@model AppWeb1.Models.Usuario
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Gestión de Usuarios";

    // --- CORRECCIÓN 1: LEER LAS VARIABLES CORRECTAS DEL CONTROLADOR ---
    var staffUsuarios = ViewBag.StaffUsuarios as List<AppWeb1.Models.Usuario>;
    var esSuperAdmin = ViewBag.EsSuperAdmin as bool? ?? false;
    var rolActual = Context.Session.GetString("Rol")?.ToLowerInvariant();
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="fas fa-user-plus"></i> Crear Nuevo Usuario (Staff)
    </h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="CrearUsuario" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="NombreUsuario" class="form-label fw-bold">
                            <i class="fas fa-user"></i> Nombre de Usuario
                        </label>
                        <input asp-for="NombreUsuario" class="form-control" placeholder="Ingrese nombre de usuario" />
                        <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Contraseña" class="form-label fw-bold">
                            <i class="fas fa-lock"></i> Contraseña
                        </label>
                        <input asp-for="Contraseña" class="form-control" type="password" placeholder="Mínimo 6 caracteres" />
                        <span asp-validation-for="Contraseña" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        <i class="fas fa-user-tag"></i> Rol
                    </label>
                    <select name="Rol" class="form-select" required>
                        <option value="" disabled selected>Seleccione un rol</option>

                        @* SuperAdmin ve: Admin, Vendedor, Repartidor *@
                        @if (esSuperAdmin)
                        {
                            <option value="admin">Administrador</option>
                            <option value="vendedor">Vendedor</option>
                            <option value="repartidor">Repartidor</option>
                        }
                        @* Admin (que no es SuperAdmin) ve: Vendedor, Repartidor *@
                        else if (rolActual == "admin")
                        {
                            <option value="vendedor">Vendedor</option>
                            <option value="repartidor">Repartidor</option>
                        }
                    </select>
                    <div class="form-text">
                        <i class="fas fa-info-circle"></i>
                        @if (esSuperAdmin)
                        {
                            <span>Puede crear Admins, Vendedores y Repartidores.</span>
                        }
                        else if (rolActual == "admin")
                        {
                            <span>Puede crear Vendedores y Repartidores.</span>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Crear Usuario
                    </button>
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Volver al Panel
                    </a>
                </div>
            </form>
        </div>
    </div>

    @* Tabla de usuarios existentes *@

    @if (staffUsuarios != null && staffUsuarios.Count > 0)
    {
        <div class="card shadow-sm mt-5">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">
                    <i class="fas fa-users"></i> Usuarios de Staff Registrados
                </h3>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle" id="tablaUsuarios">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 5%">#</th>
                                <th style="width: 25%">Usuario</th>
                                <th style="width: 25%">Contraseña (para cambiar)</th>
                                <th style="width: 15%">Rol</th>
                                <th style="width: 30%" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int contador = 1;
                            }
                            @foreach (var usuario in staffUsuarios)
                            {
                                <tr id="fila-@usuario.Id" data-rol="@usuario.Rol">
                                    <td class="text-center fw-bold">@contador</td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                                            <input type="text" class="form-control" id="user-@usuario.Id" value="@usuario.NombreUsuario" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                            <input type="password" class="form-control" id="pass-@usuario.Id" placeholder="Nueva contraseña (opcional)" />
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge
                                                    @(usuario.Rol == "superadmin" ? "bg-danger" :
                                                                                            usuario.Rol == "admin" ? "bg-primary" :
                                                                                            usuario.Rol == "vendedor" ? "bg-success" :
                                                                                            "bg-info text-dark")">
                                    @usuario.Rol
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button class="btn btn-success" onclick="guardarAdmin(@usuario.Id)" title="Guardar cambios">
                                        <i class="fas fa-save"></i> Guardar
                                    </button>
                                    <button class="btn btn-danger" onclick="eliminarAdmin(@usuario.Id, '@usuario.Rol', '@usuario.NombreUsuario')" title="Eliminar usuario">
                                        <i class="fas fa-trash"></i> Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                                                contador++;
                            }
                        </tbody>
                    </table>
                </div>

                <div id="paginacionAdmins" class="d-flex justify-content-center mt-4"></div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4" role="alert">
            <i class="fas fa-info-circle"></i> No hay usuarios de staff registrados aún.
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (TempData["AdminCreado"] != null)
    {
        <script>
            Swal.fire('¡Usuario Creado!', '@TempData["AdminCreado"]', 'success');
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire('Error', '@TempData["Error"]', 'error');
        </script>
    }


    <script>
        // --- CORRECCIÓN 5: JAVASCRIPT ---

        // Variable para el rol del usuario que está viendo la página
        const rolSesionActual = '@rolActual';

        // Función para guardar cambios de un usuario
        function guardarAdmin(id) {
            const nombreUsuario = document.getElementById(`user-${id}`).value.trim();
            const contraseña = document.getElementById(`pass-${id}`).value.trim(); // Solo se envía si se escribe una nueva

            // Validaciones
            if (!nombreUsuario || nombreUsuario.length < 3) {
                Swal.fire('Advertencia', 'El nombre de usuario debe tener al menos 3 caracteres.', 'warning');
                return;
            }

            // Si el usuario escribió una contraseña, validarla.
            if (contraseña && contraseña.length < 6) {
                Swal.fire('Advertencia', 'La nueva contraseña debe tener al menos 6 caracteres.', 'warning');
                return;
            }

            Swal.fire({
                title: 'Guardando...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            // URL correcta (sin área)
            fetch('/Usuario/ActualizarAdmin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    // Token desde el meta-tag (asumiendo que está en _Layout.cshtml)
                    'RequestVerificationToken': document.querySelector('meta[name="request-verification-token"]').content
                },
                body: JSON.stringify({ id, nombreUsuario, contraseña: contraseña || '' }) // Enviar contraseña vacía si no se cambió
            })
            .then(response => response.json())
            .then(data => {
                Swal.fire({
                    icon: data.success ? 'success' : 'error',
                    title: data.success ? '¡Actualizado!' : 'Error',
                    text: data.message,
                }).then(() => {
                    if (data.success) {
                        // Limpiar el campo de contraseña después de guardar
                        document.getElementById(`pass-${id}`).value = "";
                    }
                });
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire('Error', 'Ocurrió un error al actualizar el usuario.', 'error');
            });
        }

        // Función para eliminar un usuario
        function eliminarAdmin(id, rolUsuario, nombreUsuario) {

            // Replicar la lógica de permisos del controlador en el cliente (para feedback rápido)
            let puedeEliminar = false;
            let mensajeError = '';

            if (rolSesionActual === 'superadmin') {
                 // SuperAdmin puede eliminar a todos menos a un 'superadmin' (según regla del controlador)
                if (rolUsuario !== 'superadmin') {
                    puedeEliminar = true;
                } else {
                    mensajeError = 'Un SuperAdmin no puede ser eliminado.';
                }
            } else if (rolSesionActual === 'admin') {
                // Admin puede eliminar vendedor y repartidor
                if (rolUsuario === 'vendedor' || rolUsuario === 'repartidor') {
                    puedeEliminar = true;
                } else {
                    mensajeError = 'No tiene permiso para eliminar a un Admin o SuperAdmin.';
                }
            } else {
                mensajeError = 'No tiene permisos para eliminar usuarios.';
            }

            if (!puedeEliminar) {
                Swal.fire('Acceso Denegado', mensajeError, 'error');
                return;
            }

            // Confirmar eliminación
            Swal.fire({
                title: '¿Está seguro?',
                html: `¿Desea eliminar al usuario <strong>${nombreUsuario}</strong> (${rolUsuario})?<br>Esta acción no se puede deshacer.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-trash"></i> Sí, eliminar',
                cancelButtonText: '<i class="fas fa-times"></i> Cancelar',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Eliminando...',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    // URL correcta (sin área)
                    fetch(`/Usuario/EliminarAdmin?id=${id}`, {
                        method: 'POST',
                        headers: {
                            // Token desde el meta-tag
                            'RequestVerificationToken': document.querySelector('meta[name="request-verification-token"]').content
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            const fila = document.getElementById(`fila-${id}`);
                            if (fila) {
                                fila.remove();
                            }
                            paginateAdmins(); // Re-paginar

                            const tablaBody = document.querySelector('#tablaUsuarios tbody');
                            if (tablaBody && tablaBody.children.length === 0) {
                                location.reload(); // Recargar si la tabla queda vacía
                            }
                        }

                        Swal.fire({
                            icon: data.success ? 'success' : 'error',
                            title: data.success ? '¡Eliminado!' : 'Error',
                            text: data.message,
                        });
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire('Error', 'Ocurrió un error al eliminar el usuario.', 'error');
                    });
                }
            });
        }

        // --- PAGINACIÓN ---
        // (Tu código de paginación está bien, lo incluyo sin cambios)
        function paginateAdmins() {
             const rows = document.querySelectorAll("#tablaUsuarios tbody tr");
             const rowsPerPage = 10;
             const pagination = document.getElementById("paginacionAdmins");

             if (!pagination || rows.length === 0) {
                if(pagination) pagination.innerHTML = ""; // Limpiar paginación si no hay filas
                return;
             }

             function showPage(page) {
                 const start = page * rowsPerPage;
                 const end = start + rowsPerPage;

                 rows.forEach((row, index) => {
                     row.style.display = (index >= start && index < end) ? "" : "none";
                     const numeroCell = row.querySelector('td:first-child');
                     if (numeroCell && index >= start && index < end) {
                         numeroCell.textContent = index + 1;
                     }
                 });

                 const buttons = pagination.querySelectorAll('button');
                 buttons.forEach((btn, i) => {
                    // El índice del botón de página comienza después del botón 'prev'
                    if (i > 0 && (i-1) === page) {
                         btn.classList.remove('btn-outline-primary');
                         btn.classList.add('btn-primary');
                     } else if (i > 0 && (i-1) !== page && !btn.classList.contains('prev-next')) {
                         btn.classList.remove('btn-primary');
                         btn.classList.add('btn-outline-primary');
                     }
                 });

                 // Habilitar/deshabilitar prev/next
                 pagination.querySelector('.prev-btn').disabled = (page === 0);
                 pagination.querySelector('.next-btn').disabled = (page === (totalPages - 1));
             }

             let totalPages = 0; // Hacerla accesible

             function createPagination() {
                 pagination.innerHTML = "";
                 totalPages = Math.ceil(rows.length / rowsPerPage); // Asignar valor

                 if (totalPages <= 1) {
                     showPage(0);
                     return;
                 }

                 const prevBtn = document.createElement("button");
                 prevBtn.innerHTML = '<i class="fas fa-chevron-left"></i>';
                 prevBtn.className = "btn btn-sm btn-outline-primary mx-1 prev-btn prev-next";
                 prevBtn.onclick = () => {
                     const currentPage = parseInt(pagination.dataset.currentPage || 0);
                     if (currentPage > 0) {
                         pagination.dataset.currentPage = currentPage - 1;
                         showPage(currentPage - 1);
                     }
                 };
                 pagination.appendChild(prevBtn);

                 for (let i = 0; i < totalPages; i++) {
                     const btn = document.createElement("button");
                     btn.textContent = i + 1;
                     btn.className = "btn btn-sm btn-outline-primary mx-1";
                     btn.onclick = () => {
                         pagination.dataset.currentPage = i;
                         showPage(i);
                     };
                     pagination.appendChild(btn);
                 }

                 const nextBtn = document.createElement("button");
                 nextBtn.innerHTML = '<i class="fas fa-chevron-right"></i>';
                 nextBtn.className = "btn btn-sm btn-outline-primary mx-1 next-btn prev-next";
                 nextBtn.onclick = () => {
                     const currentPage = parseInt(pagination.dataset.currentPage || 0);
                     if (currentPage < totalPages - 1) {
                         pagination.dataset.currentPage = currentPage + 1;
                         showPage(currentPage + 1);
                     }
                 };
                 pagination.appendChild(nextBtn);

                 pagination.dataset.currentPage = 0;
                 showPage(0);
             }

             createPagination();
         }

         window.addEventListener("DOMContentLoaded", () => {
             paginateAdmins();
         });
    </script>

    <style>
        .card {
            border: none;
            border-radius: 10px;
        }

        .card-header {
            border-radius: 10px 10px 0 0 !important;
        }

        .table td {
            vertical-align: middle;
        }

        .input-group-text {
            background-color: #f8f9fa;
            border-right: none;
        }

        .input-group .form-control {
            border-left: none;
        }

            .input-group .form-control:focus {
                box-shadow: none;
                border-color: #ced4da;
            }

        .badge {
            font-size: 0.875rem;
            padding: 0.5em 0.75em;
            text-transform: capitalize;
        }

        .btn-group-sm > .btn {
            font-size: 0.875rem;
        }

        #paginacionAdmins button {
            min-width: 40px;
        }

        .swal2-popup {
            border-radius: 10px;
        }
    </style>
}
</file>

