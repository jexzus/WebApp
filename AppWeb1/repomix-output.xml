<file path="Areas/Cliente/Views/Cliente/EstadoPedido.cshtml">
@model List<AppWeb1.Models.Pedido>

@{
    ViewData["Title"] = "Mis Pedidos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Ordenar primero los no entregados, luego los entregados
    var pedidosOrdenados = Model
        .OrderBy(p => p.EstadoPedido == "Entregado" ? 1 : 0)
        .ThenByDescending(p => p.FechaPedido)
        .ToList();
}

@section Styles {
    <style>
        @@media print {
            display: none !important;
        }

        .table {
            font-size: 12px;
        }

        h2 {
            text-align: center;
        }

}

    .fila-entregado {
        background-color: #e6ffe6 !important; /* verde claro */
    }
</style>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <h2 class="mb-0">📦 Historial de Pedidos</h2>
        <button class="btn btn-warning" onclick="window.print()">🖨️ Imprimir</button>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay pedidos registrados.</div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>N° Pedido</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Productos</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pedido in pedidosOrdenados)
                {
                    var esEntregado = pedido.EstadoPedido == "Entregado";
                    var claseFila = esEntregado ? "fila-entregado" : "";

                    <tr class="@claseFila">
                        <td>@pedido.NumPedido</td>
                        <td>@pedido.FechaPedido?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@pedido.EstadoPedido</td>
                        <td>
                            <ul class="mb-0">
                                @foreach (var item in pedido.DetallePedidos)
                                {
                                    <li>@item.IdProductoNavigation?.NombreProducto x @item.Cantidad</li>
                                }
                            </ul>
                        </td>
                        <td>@pedido.MontoTotal?.ToString("C", new System.Globalization.CultureInfo("es-AR"))</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-4 no-print">
        <a asp-controller="Cliente" asp-action="Catalogo" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver al Catálogo
        </a>
    </div>
</div>
