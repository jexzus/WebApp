<file path="Areas/Admin/Views/Pedidos/Detalle.cshtml">
@model AppWeb1.Models.Pedido
@using Microsoft.AspNetCore.Http
@using static AppWeb1.Security.Roles // Importamos los helpers de seguridad

@{
    ViewData["Title"] = $"Detalle Pedido N° {Model.NumPedido}";

    // --- 1. Determinamos los permisos para ESTA vista ---
    var rol = Context.Session.GetString("Rol");
    bool puedeAsignar = PuedeAsignarPedidos(Context.Session);
    bool puedeMarcarEntregado = PuedeMarcarEntregado(Context.Session);
    bool esAdminPanel = EsAdminOSuperAdmin(Context.Session);
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Pedido N° @Model.NumPedido</h4>
                </div>
                <div class="card-body">
                    <p><strong>Cliente:</strong> @Model.IdClienteNavigation?.Nombre @Model.IdClienteNavigation?.Apellido</p>
                    <p><strong>Domicilio:</strong> @Model.IdClienteNavigation?.Domicilio</p>
                    <p><strong>Teléfono:</strong> @Model.IdClienteNavigation?.NumTelefono</p>
                    <p><strong>Fecha:</strong> @Model.FechaPedido?.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Observaciones:</strong> @Model.Observaciones</p>

                    <p><strong>Modo de Entrega:</strong> @Model.ModoEntrega</p>

                    <hr />
                    <h5 class="mt-3">Productos:</h5>
                    <ul class="list-group">
                        @foreach (var item in Model.DetallePedidos)
                        {
                            var precio = item.PrecioUnitario;

                            var subtotal = (item.Subtotal > 0) ? item.Subtotal : (precio * item.Cantidad);

                            <li class="list-group-item d-flex justify-content-between align-items-center">

                                @(item.IdProductoNavigation?.NombreProducto ?? "Producto no encontrado")

                                <span>@item.Cantidad x @precio.ToString("C")</span>
                                <span class="fw-bold">@subtotal.ToString("C")</span>
                            </li>
                        }
                    </ul>
                    <h4 class="text-end mt-3">Total: @Model.MontoTotal?.ToString("C")</h4>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Estado y Acciones</h5>
                </div>
                <div class="card-body">
                    <h3 class="text-center mb-3">
                        Estado: <span class="badge bg-info text-dark" style="text-transform: capitalize;">@Model.EstadoPedido</span>
                    </h3>

                    @* --- REQ 1: SECCIÓN ASIGNAR REPARTIDOR --- *@
                    @if (puedeAsignar)
                    {
                        @if (Model.ModoEntrega == "Domicilio")
                        {
                            <div class="mb-3">
                                <form asp-action="AsignarRepartidor" method="post">
                                    <input type="hidden" name="idPedido" value="@Model.NumPedido" />
                                    <label class="form-label fw-bold">Asignar Repartidor:</label>

                                    <select name="idRepartidor" class="form-select" asp-items="@(ViewData["RepartidoresList"] as SelectList)">
                                        <option value="">Seleccionar repartidor...</option>
                                    </select>

                                    <div class="d-grid mt-2">
                                        <button type="submit" class="btn btn-primary"
                                                @(Model.EstadoPedido == "Entregado" || Model.EstadoPedido == "Cancelado" ? "disabled" : "")>
                                            <i class="fas fa-motorcycle"></i> Asignar y Poner "En Reparto"
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }
                        else // Si el ModoEntrega es "Retiro" o cualquier otra cosa
                        {
                            <div class="alert alert-light" role="alert">
                                <i class="fas fa-store-alt"></i>
                                Este pedido es para <strong>"@Model.ModoEntrega"</strong>. No requiere asignación de repartidor.
                            </div>
                        }
                        <hr />
                    }

                    <p><strong>Repartidor Asignado:</strong></p>
                    <p class="fs-5">
                        @if (Model.Repartidor != null)
                        {
                            <i class="fas fa-user-check text-success"></i>
                            @Model.Repartidor.Usuario?.NombreUsuario
                        }
                        else
                        {
                            <i class="fas fa-user-clock text-muted"></i>
                            <span>Sin asignar</span>
                        }
                    </p>
                    <hr />

                    @* --- REQ 2: SECCIÓN CAMBIAR ESTADO --- *@

                    @if (puedeMarcarEntregado && Model.EstadoPedido == "En reparto")
                    {
                        <form asp-action="CambiarEstado" method="post" class="d-grid">
                            <input type="hidden" name="id" value="@Model.NumPedido" />
                            <input type="hidden" name="nuevoEstado" value="Entregado" />
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-check-circle"></i> Marcar como Entregado
                            </button>
                        </form>
                    }

                    @if (puedeAsignar && Model.EstadoPedido != "Entregado" && Model.EstadoPedido != "Cancelado")
                    {
                        <div class="mt-3">
                            <p class="fw-bold">Otras acciones:</p>

                            @if (Model.EstadoPedido == "Pendiente")
                            {
                                <form asp-action="CambiarEstado" method="post" class="d-grid mb-2">
                                    <input type="hidden" name="id" value="@Model.NumPedido" />
                                    <input type="hidden" name="nuevoEstado" value="En preparación" />
                                    <button type="submit" class="btn btn-warning text-dark">Mover a "En Preparación"</button>
                                </form>
                            }

                            <form asp-action="CambiarEstado" method="post" class="d-grid">
                                <input type="hidden" name="id" value="@Model.NumPedido" />
                                <input type="hidden" name="nuevoEstado" value="Cancelado" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-times"></i> Cancelar Pedido
                                </button>
                            </form>
                        </div>
                    }

                </div>
            </div>

            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Volver a la Lista de Pedidos
            </a>

            @if (esAdminPanel)
            {
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-info text-dark mt-2">
                    <i class="fas fa-tasks"></i> Volver al Panel
                </a>
            }
        </div>
    </div>
</div>
</file>

<file path="Areas/Admin/Views/Pedidos/Index.cshtml">
@model List<AppWeb1.Models.Pedido>
@{
    ViewData["Title"] = "Gestión de Pedidos";
    var pedidosOrdenados = Model
        .OrderBy(p => p.EstadoPedido == "Entregado" ? 1 : 0)
        .ThenByDescending(p => p.FechaPedido)
        .ToList();
}

@section Styles {
    <style>
        .fila-entregado {
            background-color: #e6ffe6 !important;
        }

        .btn-imprimir {
            margin-right: 0.5rem;
        }

        @@media print {
            body * {
                visibility: hidden;
            }

            #printArea, #printArea * {
                visibility: visible;
            }

            #printArea {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>
}

<h2 class="mb-4">Gestión de Pedidos</h2>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <div>
        <button class="btn btn-warning btn-imprimir" onclick="imprimirTabla()">
            <i class="fas fa-print"></i> Imprimir
        </button>
        <form method="post" asp-action="DescargarExcel" class="d-inline">
            <button class="btn btn-success" type="submit">
                <i class="fas fa-file-excel"></i> Exportar Excel
            </button>
        </form>
    </div>
    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Volver al Panel
    </a>
</div>

<div class="mb-3 no-print">
    <label for="filtroEstado" class="form-label">Filtrar por estado:</label>
    <select id="filtroEstado" class="form-select" multiple>
        <option value="Pendiente" selected>Pendiente</option>
        <option value="En preparación">En preparación</option>
        <option value="En reparto">En reparto</option>
        <option value="Entregado">Entregado</option>
    </select>
    <small class="form-text text-muted">Mantén Ctrl/Cmd presionado para seleccionar múltiples estados</small>
</div>

<div class="mb-3 no-print">
    <label for="buscador" class="form-label">Buscar:</label>
    <input type="text" id="buscador" class="form-control" placeholder="Buscar por Nro Pedido, IdCliente, Nombre, Apellido o Domicilio...">
</div>

<div id="printArea">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Número</th>
                <th>Cliente</th>
                <th>Teléfono</th>
                <th>Domicilio</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Total</th>
                <th class="no-print">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pedido in pedidosOrdenados)
            {
                var filaClase = pedido.EstadoPedido == "Entregado" ? "fila-entregado" : "";
                <tr class="@filaClase"
                    data-num="@pedido.NumPedido"
                    data-estado="@pedido.EstadoPedido"
                    data-filtro="@pedido.NumPedido @pedido.IdCliente @pedido.IdClienteNavigation?.Nombre @pedido.IdClienteNavigation?.Apellido @pedido.IdClienteNavigation?.Domicilio">
                    <td>@pedido.NumPedido</td>
                    <td>@pedido.IdClienteNavigation?.Nombre @pedido.IdClienteNavigation?.Apellido</td>
                    <td>@pedido.IdClienteNavigation?.NumTelefono</td>
                    <td>@pedido.IdClienteNavigation?.Domicilio</td>
                    <td>@pedido.FechaPedido?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="badge bg-@(pedido.EstadoPedido == "Pendiente" ? "warning" :
                                                                               pedido.EstadoPedido == "En preparación" ? "info" :
                                                                               pedido.EstadoPedido == "En reparto" ? "primary" : "success")">
                        @pedido.EstadoPedido
                    </span>
                </td>
                <td>@((pedido.MontoTotal ?? 0m).ToString("C"))</td>
                <td class="no-print">
                    <a asp-action="Detalle" asp-route-id="@pedido.NumPedido" class="btn btn-sm btn-primary me-1">Ver</a>
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-warning dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            Estado
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item cambiar-estado" href="#" data-pedido="@pedido.NumPedido" data-estado="Pendiente">Pendiente</a></li>
                            <li><a class="dropdown-item cambiar-estado" href="#" data-pedido="@pedido.NumPedido" data-estado="En preparación">En preparación</a></li>
                            <li><a class="dropdown-item cambiar-estado" href="#" data-pedido="@pedido.NumPedido" data-estado="En reparto">En reparto</a></li>
                            <li><a class="dropdown-item cambiar-estado" href="#" data-pedido="@pedido.NumPedido" data-estado="Entregado">Entregado</a></li>
                        </ul>
                    </div>
                </td>
            </tr>
                        }
        </tbody>
    </table>
</div>

<partial name="_ModalConfirmacionGlobal" />

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div class="toast align-items-center text-bg-success border-0" role="alert" id="toastExito" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMensaje">Acción completada correctamente.</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
        </div>
    </div>
</div>

