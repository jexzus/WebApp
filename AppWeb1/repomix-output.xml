<file path="Security/Roles.cs">
using Microsoft.AspNetCore.Http;
using System;

namespace AppWeb1.Security
{
    public static class Roles
    {
        public static bool Es(string? rolSesion, string rolEsperado)
            => !string.IsNullOrWhiteSpace(rolSesion) &&
               string.Equals(rolSesion, rolEsperado, StringComparison.OrdinalIgnoreCase);

        // --- Roles base ---
        public static bool EsSuperAdmin(ISession s) => Es(s.GetString("Rol"), "superadmin");
        public static bool EsAdmin(ISession s) => Es(s.GetString("Rol"), "admin");
        public static bool EsVendedor(ISession s) => Es(s.GetString("Rol"), "vendedor");
        public static bool EsRepartidor(ISession s) => Es(s.GetString("Rol"), "repartidor");
        public static bool EsCliente(ISession s) => Es(s.GetString("Rol"), "cliente");

        // --- Grupos de permisos reutilizables ---

        // Acceso al panel de admin (Home/Index)
        public static bool EsAdminOSuperAdmin(ISession s)
            => EsSuperAdmin(s) || EsAdmin(s);

        // Acceso a Catálogo (superadmin/admin/vendedor)
        public static bool PuedeVerCatalogo(ISession s)
            => EsSuperAdmin(s) || EsAdmin(s) || EsVendedor(s);

        // --- (NUEVO HELPER RECOMENDADO) ---
        // Permiso para asignar repartidores y cambiar estados (Admin, Vendedor, SuperAdmin)
        public static bool PuedeAsignarPedidos(ISession s)
            => EsSuperAdmin(s) || EsAdmin(s) || EsVendedor(s);


        // Gestión de usuarios:
        public static bool PuedeCrearAdmin(ISession s) => EsSuperAdmin(s);
        public static bool PuedeCrearRepartidor(ISession s) => EsSuperAdmin(s) || EsAdmin(s);
        public static bool PuedeCrearVendedor(ISession s) => EsSuperAdmin(s) || EsAdmin(s);

        // Gestión de pedidos: pueden entrar super/admin/vendedor/repartidor
        public static bool PuedeGestionarPedidos(ISession s)
            => EsSuperAdmin(s) || EsAdmin(s) || EsVendedor(s) || EsRepartidor(s);

        // Transición especial: EnReparto -> Entregado
        public static bool PuedeMarcarEntregado(ISession s)
            => EsSuperAdmin(s) || EsRepartidor(s);

        // Por compatibilidad con código previo
        public static bool AdminOVendedor(ISession s)
            => EsAdmin(s) || EsVendedor(s);
    }
}
</file>

