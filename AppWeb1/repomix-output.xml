        <input asp-for="ImagenArchivo" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
        <span asp-validation-for="ImagenArchivo" class="text-danger"></span>
        <img id="previewImagen" class="img-thumbnail mt-3 d-none" style="max-height:150px;" />
    </div>

    <button type="submit" class="btn btn-success">Guardar cambios</button>
    <a asp-area="Admin" asp-controller="Catalogo" asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('input[type="file"]').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e2 => {
                const img = document.getElementById('previewImagen');
                img.src = e2.target.result;
                img.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        });
    </script>
}
</file>

<file path="Areas/Admin/Views/Catalogo/Index.cshtml">
@model List<AppWeb1.Models.Producto>
@{
    ViewData["Title"] = "Gestión de Catálogo";
    string? mensaje = TempData.Peek("Success") as string;
    string? error = TempData.Peek("Error") as string;
    string titulo = "Operación exitosa";
    if (!string.IsNullOrEmpty(mensaje))
    {
        if (mensaje.Contains("creado", StringComparison.OrdinalIgnoreCase))
            titulo = "Producto agregado";
        else if (mensaje.Contains("actualizado", StringComparison.OrdinalIgnoreCase) || mensaje.Contains("modificado", StringComparison.OrdinalIgnoreCase))
            titulo = "Producto modificado";
        else if (mensaje.Contains("eliminado", StringComparison.OrdinalIgnoreCase))
            titulo = "Producto eliminado";
    }
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Catálogo de Productos</h2>
        <a asp-area="Admin" asp-controller="Catalogo" asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Nuevo Producto
        </a>
    </div>
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" id="buscadorProductos" class="form-control" placeholder="Buscar productos por nombre o descripción...">
        </div>
        <div class="col-md-6">
            <div class="text-end">
                <span class="text-muted">Total de productos: <strong id="totalProductos">@(Model?.Count ?? 0)</strong></span>
            </div>
        </div>
    </div>
    <div class="row" id="contenedorProductos">
        @if (Model != null && Model.Any())
        {
            @foreach (var producto in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4 producto-card" data-nombre="@producto.NombreProducto?.ToLower()" data-descripcion="@producto.Descripcion?.ToLower()">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(producto.Imagen))
                        {
                            <img src="~/imagenes/@producto.Imagen" class="card-img-top producto-img" alt="@producto.NombreProducto" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 200px;">
                                <i class="fas fa-image fa-3x text-muted"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@producto.NombreProducto</h5>
                            <p class="card-text flex-grow-1">@producto.Descripcion</p>
                            <p class="card-text">
                                <strong class="text-success fs-5">@producto.Precio?.ToString("C")</strong>
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="btn-group w-100" role="group">
                                <a asp-area="Admin" asp-controller="Catalogo" asp-action="Edit" asp-route-id="@producto.IdProducto" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                <a asp-area="Admin" asp-controller="Catalogo" asp-action="Delete" asp-route-id="@producto.IdProducto"
                                   class="btn btn-outline-danger btn-sm">
                                    <i class="fas fa-trash"></i> Eliminar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No hay productos en el catálogo</h4>
                    <p class="text-muted">Comienza agregando tu primer producto</p>
                    <a asp-area="Admin" asp-controller="Catalogo" asp-action="Create" class="btn btn-success">
                        <i class="fas fa-plus"></i> Crear Primer Producto
                    </a>
                </div>
            </div>
        }
    </div>
    <div class="mt-4">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver al Panel
        </a>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: '@titulo',
                text: '@mensaje',
                background: '#fff3cd',
                color: '#000',
                confirmButtonText: 'Aceptar',
                customClass: {
                    title: 'fw-bold',
                    popup: 'border border-warning'
                }
            });
        </script>
    }
    <script>
        // Funcionalidad de búsqueda
        document.getElementById('buscadorProductos').addEventListener('input', function () {
            const filtro = this.value.toLowerCase();
            const productos = document.querySelectorAll('.producto-card');
            let productosVisibles = 0;
            productos.forEach(function (producto) {
                const nombre = producto.getAttribute('data-nombre') || '';
                const descripcion = producto.getAttribute('data-descripcion') || '';
                if (nombre.includes(filtro) || descripcion.includes(filtro)) {
                    producto.style.display = '';
                    productosVisibles++;
                } else {
                    producto.style.display = 'none';
                }
            });
            document.getElementById('totalProductos').textContent = productosVisibles;
        });
        // Auto-dismiss alerts después de 5 segundos
        setTimeout(function () {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(function (alert) {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}
</file>

