@model List<AppWeb1.Models.DetallePedido>
@using System.Linq
@{
    ViewData["Title"] = "Carrito de Compras";
}

<h2>Carrito de Compras</h2>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Precio Unitario</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>
                            @if (Model[i].IdProductoNavigation != null)
                            {
                                @Model[i].IdProductoNavigation.NombreProducto
                            }
                            else
                            {
                                <span class="text-muted">Producto no encontrado</span>
                            }
                        </td>
                        <td>@Model[i].PrecioUnitario.ToString("C")</td>
                        <td>@Model[i].Cantidad</td>
                        <td>@((Model[i].PrecioUnitario * Model[i].Cantidad).ToString("C"))</td>
                        <td>
                            <form asp-action="EliminarDelCarrito" method="post" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="indice" value="@i" />
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('¿Está seguro de eliminar este producto?')">
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-info">
                    <th colspan="3">Total:</th>
                    <th>@Model.Sum(x => x.PrecioUnitario * x.Cantidad).ToString("C")</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="mt-4">
        <form asp-action="ConfirmarPedido" method="post">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label for="tipoEntrega">Tipo de Entrega:</label>
                        <select name="tipoEntrega" id="tipoEntrega" class="form-control" required>
                            <option value="">Seleccione...</option>
                            <option value="Domicilio">A Domicilio</option>
                            <option value="Recoger">Recoger en Tienda</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label for="observaciones">Observaciones:</label>
                        <textarea name="observaciones" id="observaciones" class="form-control" rows="3"
                              placeholder="Instrucciones especiales (opcional)"></textarea>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="Catalogo" class="btn btn-secondary">Seguir Comprando</a>
                <button type="submit" class="btn btn-success">Confirmar Pedido</button>
            </div>
        </form>
    </div>
}
else
{
    <div class="alert alert-info">
        <h4>Tu carrito está vacío</h4>
        <p>No tienes productos en tu carrito de compras.</p>
        <a asp-action="Catalogo" class="btn btn-primary">Ir al Catálogo</a>
    </div>
}