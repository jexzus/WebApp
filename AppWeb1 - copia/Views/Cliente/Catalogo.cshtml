@model IEnumerable<AppWeb1.Models.Producto>
@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Catálogo</h2>
        <a asp-action="Carrito" asp-controller="Cliente" class="btn btn-primary">
            <i class="fas fa-shopping-cart"></i> Ver Carrito
        </a>
    </div>

    <div class="row">
        @foreach (var producto in Model)
        {
            <div class="col-md-4 mb-4 producto-card">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(producto.Imagen))
                    {
                        <img src="~/imagenes/@producto.Imagen" class="card-img-top" alt="Imagen" style="height:200px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-light text-center py-5 d-flex align-items-center justify-content-center" style="height:200px;">
                            <i class="fas fa-image fa-3x text-muted"></i>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@producto.NombreProducto</h5>
                        <p class="flex-grow-1">@producto.Descripcion</p>
                        <p><strong>Precio:</strong> @producto.Precio?.ToString("C")</p>
                        <form asp-action="AgregarCarrito" method="post" asp-controller="Cliente">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idProducto" value="@producto.IdProducto" />
                            <div class="form-group mb-2">
                                <label>Cantidad:</label>
                                <select name="cantidad" class="form-control">
                                    @for (int i = 1; i <= 10; i++)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-success mt-2">Agregar al Carrito</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            }

        .card-img-top {
            transition: transform 0.2s ease-in-out;
        }

        .card:hover .card-img-top {
            transform: scale(1.05);
        }

        .producto-card {
            transition: opacity 0.3s ease-in-out;
        }
    </style>
}
