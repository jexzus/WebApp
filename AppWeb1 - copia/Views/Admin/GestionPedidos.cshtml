@model List<AppWeb1.Models.Pedido>
@{
    ViewData["Title"] = "Gestión de Pedidos";
}

<h2>Gestión de Pedidos</h2>

<div class="mb-3">
    <label for="filtroEstado" class="form-label">Filtrar por estado:</label>
    <select id="filtroEstado" class="form-select" multiple>
        <option value="Pendiente" selected>Pendiente</option>
        <option value="En preparación">En preparación</option>
        <option value="En reparto">En reparto</option>
        <option value="Entregado">Entregado</option>
    </select>
    <small class="form-text text-muted">Mantén Ctrl/Cmd presionado para seleccionar múltiples estados</small>
</div>

<div class="mb-3">
    <label for="buscador" class="form-label">Buscar:</label>
    <input type="text" id="buscador" class="form-control" placeholder="Buscar por Nro Pedido, IdCliente, Nombre, Apellido o Domicilio...">
</div>

<table class="table table-bordered table-hover" id="tablaPedidos">
    <thead>
        <tr>
            <th>Número</th>
            <th>Cliente</th>
            <th>Teléfono</th>
            <th>Domicilio</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Total</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pedido in Model)
        {
            <tr data-estado="@pedido.EstadoPedido" data-filtro="@pedido.NumPedido @pedido.IdCliente @pedido.IdClienteNavigation?.Nombre @pedido.IdClienteNavigation?.Apellido @pedido.IdClienteNavigation?.Domicilio">
                <td>@pedido.NumPedido</td>
                <td>@pedido.IdClienteNavigation?.Nombre @pedido.IdClienteNavigation?.Apellido</td>
                <td>@pedido.IdClienteNavigation?.NumTelefono</td>
                <td>@pedido.IdClienteNavigation?.Domicilio</td>
                <td>@pedido.FechaPedido?.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <span class="badge bg-@(pedido.EstadoPedido == "Pendiente" ? "warning" :
                                                                    pedido.EstadoPedido == "En preparación" ? "info" :
                                                                    pedido.EstadoPedido == "En reparto" ? "primary" : "success")">
                    @pedido.EstadoPedido
                </span>
            </td>
            <td>@pedido.MontoTotal?.ToString("C")</td>
            <td>
                <a asp-action="Detalle" asp-route-id="@pedido.NumPedido" class="btn btn-sm btn-primary me-1">Ver</a>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-warning dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        Estado
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item cambiar-estado" href="#" data-pedido="@pedido.NumPedido" data-estado="Pendiente">Pendiente</a></li>
                        <li><a class="dropdown-item cambiar-estado" href="#" data-pedido="@pedido.NumPedido" data-estado="En preparación">En preparación</a></li>
                        <li><a class="dropdown-item cambiar-estado" href="#" data-pedido="@pedido.NumPedido" data-estado="En reparto">En reparto</a></li>
                        <li><a class="dropdown-item cambiar-estado" href="#" data-pedido="@pedido.NumPedido" data-estado="Entregado">Entregado</a></li>
                    </ul>
                </div>
            </td>
        </tr>
                }
    </tbody>
</table>

<!-- Modal de confirmación -->
<div class="modal fade" id="modalConfirmacion" tabindex="-1" aria-labelledby="modalConfirmacionLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalConfirmacionLabel">Confirmar cambio de estado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro que desea cambiar el estado del pedido <span id="numeroPedido"></span> a <span id="nuevoEstado"></span>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="confirmarCambio">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const filtroEstado = document.getElementById("filtroEstado");
        const buscador = document.getElementById("buscador");
        const filas = document.querySelectorAll("#tablaPedidos tbody tr");

        // Función de filtrado mejorada
        function filtrar() {
            const estadosSeleccionados = Array.from(filtroEstado.selectedOptions).map(opt => opt.value.toLowerCase());
            const texto = buscador.value.toLowerCase();

            filas.forEach(fila => {
                const estado = fila.getAttribute("data-estado").toLowerCase();
                const textoFila = fila.getAttribute("data-filtro").toLowerCase();

                // Verificar si coincide con alguno de los estados seleccionados
                const coincideEstado = estadosSeleccionados.length === 0 || estadosSeleccionados.includes(estado);
                const coincideTexto = texto === "" || textoFila.includes(texto);

                fila.style.display = (coincideEstado && coincideTexto) ? "" : "none";
            });
        }

        // Event listeners para filtros
        filtroEstado.addEventListener("change", filtrar);
        buscador.addEventListener("input", filtrar);

        // Funcionalidad para cambiar estado
        let pedidoActual = null;
        let estadoActual = null;

        // Event listener para los enlaces de cambio de estado
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('cambiar-estado')) {
                e.preventDefault();
                pedidoActual = e.target.getAttribute('data-pedido');
                estadoActual = e.target.getAttribute('data-estado');

                document.getElementById('numeroPedido').textContent = pedidoActual;
                document.getElementById('nuevoEstado').textContent = estadoActual;

                const modal = new bootstrap.Modal(document.getElementById('modalConfirmacion'));
                modal.show();
            }
        });

        // Confirmar cambio de estado
        document.getElementById('confirmarCambio').addEventListener('click', function() {
            if (pedidoActual && estadoActual) {
                // Realizar petición AJAX para cambiar el estado
                fetch('/Admin/CambiarEstadoAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        NumPedido: parseInt(pedidoActual),
                        NuevoEstado: estadoActual
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        // Actualizar la fila en la tabla
                        const fila = document.querySelector(`tr[data-filtro*="${pedidoActual}"]`);
                        if (fila) {
                            fila.setAttribute('data-estado', estadoActual);

                            // Actualizar el badge de estado
                            const estadoCell = fila.cells[5];
                            let badgeClass = 'bg-warning';
                            switch(estadoActual) {
                                case 'En preparación': badgeClass = 'bg-info'; break;
                                case 'En reparto': badgeClass = 'bg-primary'; break;
                                case 'Entregado': badgeClass = 'bg-success'; break;
                            }
                            estadoCell.innerHTML = `<span class="badge ${badgeClass}">${estadoActual}</span>`;
                        }

                        // Mostrar mensaje de éxito
                        alert('Estado actualizado correctamente');

                        // Aplicar filtros nuevamente
                        filtrar();
                    } else {
                        alert('Error al actualizar el estado: ' + (data.message || 'Error desconocido'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al actualizar el estado: ' + error.message);
                });

                // Cerrar modal
                bootstrap.Modal.getInstance(document.getElementById('modalConfirmacion')).hide();
            }
        });

        // Aplicar filtro inicial
        filtrar();
    </script>
}