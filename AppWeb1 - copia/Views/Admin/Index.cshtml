@{
    ViewData["Title"] = "Panel de Administración";
}

<h2 class="mb-4 text-dark">Panel de Administración</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card text-white mb-3" style="background-color: #f44336;">
            <div class="card-body">
                <h4 class="card-title">Catálogo de Productos</h4>
                <p class="card-text">Administrar productos del sistema (crear, editar, eliminar).</p>
                <a asp-action="GestionCatalogo" class="btn btn-warning btn-lg text-white fw-bold">Gestión de Catálogo</a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card text-white mb-3" style="background-color: #ff9800;">
            <div class="card-body">
                <h4 class="card-title">Gestión de Pedidos</h4>
                <p class="card-text">Ver y modificar el estado de los pedidos de los clientes.</p>
                <a asp-controller="Admin" asp-action="GestionPedidos" class="btn btn-danger btn-lg text-white fw-bold">Ver Pedidos</a>
            </div>
        </div>
    </div>
</div>
