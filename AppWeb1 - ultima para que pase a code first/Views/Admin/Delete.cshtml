@model AppWeb1.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<h2>Eliminar Producto</h2>

<div>
    <h4>¿Estás seguro que deseas eliminar este producto?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.NombreProducto</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>

        <dt class="col-sm-2">Precio</dt>
        <dd class="col-sm-10">@Model.Precio?.ToString("C")</dd>

        <dt class="col-sm-2">Imagen</dt>
        <dd class="col-sm-10">
            <img src="~/imagenes/@Model.Imagen" class="img-thumbnail" width="150" />
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdProducto" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-controller="Admin" asp-action="GestionCatalogo" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
